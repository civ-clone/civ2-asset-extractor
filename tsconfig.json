{
  "compilerOptions": {
    "declaration": true,
    "lib": [
      "es2020"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2018",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "node_modules",
    "tests"
  ]
}
